<mujoco model="arm3_traj">
  <compiler angle="radian"/>
  <option timestep="0.02" integrator="implicitfast" gravity="0 0 -9.81"/>
  <worldbody>
    <light pos="0 0 3" dir="0 0 -1"/>
    <geom name="floor" type="plane" size="2 2 0.1" pos="0 0 -0.02" rgba="0.85 0.85 0.88 1" contype="0" conaffinity="0"/>
    <!-- 基座 -->
    <body name="base" pos="-0.15 0 0.2">
      <geom type="cylinder" size="0.04 0.04" pos="0 0 -0.04" rgba="0.3 0.3 0.35 1" contype="0" conaffinity="0"/>
      <joint type="hinge" axis="0 0 1" name="j1" range="-3 3" limited="false" damping="0.6"/>
      <body name="link1" pos="0 0 0">
        <geom type="capsule" size="0.02 0.07" pos="0.075 0 0" rgba="0.2 0.55 0.9 1" density="200" contype="0" conaffinity="0"/>
        <body name="link2" pos="0.15 0 0">
          <joint type="hinge" axis="0 0 1" name="j2" range="-3 3" limited="false" damping="0.6"/>
          <geom type="capsule" size="0.02 0.07" pos="0.075 0 0" rgba="0.9 0.5 0.2 1" density="200" contype="0" conaffinity="0"/>
          <body name="link3" pos="0.15 0 0">
            <joint type="hinge" axis="0 0 1" name="j3" range="-3 3" limited="false" damping="0.6"/>
            <geom type="capsule" size="0.02 0.07" pos="0.075 0 0" rgba="0.55 0.7 0.25 1" density="200" contype="0" conaffinity="0"/>
            <body name="tip" pos="0.15 0 0">
              <geom type="sphere" size="0.025" rgba="0.2 0.8 0.25 1" contype="0" conaffinity="0"/>
            </body>
          </body>
        </body>
      </body>
    </body>
    <!-- 轨迹目标点(mocap) -->
    <body name="target" pos="0.30 0 0.2" mocap="true">
      <geom type="sphere" size="0.025" rgba="1 0 0 1" contype="0" conaffinity="0"/>
    </body>
  </worldbody>
  <actuator>
    <motor joint="j1" ctrlrange="-2 2" ctrllimited="false" name="a1"/>
    <motor joint="j2" ctrlrange="-2 2" ctrllimited="false" name="a2"/>
    <motor joint="j3" ctrlrange="-2 2" ctrllimited="false" name="a3"/>
  </actuator>
</mujoco>
