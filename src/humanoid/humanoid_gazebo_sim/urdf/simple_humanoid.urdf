<?xml version="1.0"?>
<robot name="simple_humanoid">
  <!-- 人形机器人主体 -->
  <link name="base_link">
    <inertial>
      <mass value="1.0"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.02" ixy="0" ixz="0" iyy="0.02" iyz="0" izz="0.01"/>
    </inertial>
    <visual>
      <geometry><box size="0.3 0.2 0.6"/></geometry>
      <material name="white"><color rgba="0.9 0.9 0.9 1"/></material>
    </visual>
    <collision><geometry><box size="0.3 0.2 0.6"/></geometry></collision>
  </link>
  <link name="head_link">
    <inertial>
      <mass value="0.2"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
    </inertial>
    <visual>
      <geometry><sphere radius="0.1"/></geometry>
      <material name="skin"><color rgba="0.8 0.6 0.4 1"/></material>
    </visual>
    <collision><geometry><sphere radius="0.1"/></geometry></collision>
  </link>
  <joint name="j_head" type="fixed">
    <parent link="base_link"/><child link="head_link"/>
    <origin xyz="0 0 0.4" rpy="0 0 0"/>
  </joint>

  <!-- 前置摄像头 -->
  <link name="camera_link">
    <inertial>
      <mass value="0.05"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
    </inertial>
    <visual><geometry><box size="0.03 0.03 0.03"/></geometry>
      <material name="black"><color rgba="0 0 0 1"/></material></visual>
    <collision><geometry><box size="0.03 0.03 0.03"/></geometry></collision>
  </link>
  <joint name="j_camera" type="fixed">
    <parent link="head_link"/><child link="camera_link"/>
    <origin xyz="0 0 0.08" rpy="0 0 0"/>
  </joint>

  <!-- 左轮 -->
  <link name="left_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual><geometry><cylinder radius="0.1" length="0.06"/></geometry>
      <material name="wheel"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><geometry><cylinder radius="0.1" length="0.06"/></geometry></collision>
  </link>
  <!-- 右轮 -->
  <link name="right_wheel_link">
    <inertial>
      <mass value="0.1"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="0.0005" ixy="0" ixz="0" iyy="0.0005" iyz="0" izz="0.0005"/>
    </inertial>
    <visual><geometry><cylinder radius="0.1" length="0.06"/></geometry>
      <material name="wheel"><color rgba="0.2 0.2 0.2 1"/></material></visual>
    <collision><geometry><cylinder radius="0.1" length="0.06"/></geometry></collision>
  </link>
  <joint name="left_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="left_wheel_link"/>
    <origin xyz="0 0.15 -0.25" rpy="1.5708 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>
  <joint name="right_wheel_joint" type="continuous">
    <parent link="base_link"/><child link="right_wheel_link"/>
    <origin xyz="0 -0.15 -0.25" rpy="1.5708 0 0"/>
    <axis xyz="1 0 0"/>
  </joint>

  <!-- 差速驱动插件：订阅 /humanoid/cmd_vel 驱动左右轮 -->
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/humanoid</namespace>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_diameter>0.2</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
    </plugin>
  </gazebo>

  <!-- 摄像头传感器：放在 <gazebo> 扩展，用 libgazebo_ros_camera 桥接到 ROS -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera_sensor">
      <always_on>true</always_on>
      <update_rate>20</update_rate>
      <camera>
        <horizontal_fov>1.047</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.1</near>
          <far>50</far>
        </clip>
      </camera>
      <plugin name="camera_plugin" filename="libgazebo_ros_camera.so">
        <ros>
          <namespace>/humanoid/camera</namespace>
        </ros>
        <frame_name>camera_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>
</robot>
